# Ejemplo para /etc/nginx/sites-available/irtra
# Sustituya el dominio y obtenga un certificado válido.
server {
    listen 80;
    server_name irtra.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name irtra.example.com;
    ssl_certificate /etc/letsencrypt/live/irtra.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/irtra.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 55m;
    proxy_hide_header X-Powered-By;

    location / {
        proxy_pass https://127.0.0.1:3443;
        # El certificado interno puede ser autofirmado porque este enlace usa loopback.
        proxy_ssl_verify off;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
    }
}

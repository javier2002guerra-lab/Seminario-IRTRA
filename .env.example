NODE_ENV=production
PORT=3443
BIND_HOST=127.0.0.1
APP_BASE_URL=https://localhost:3443

# Genere valores aleatorios de al menos 64 caracteres. Nunca use estos ejemplos.
SESSION_SECRET=reemplazar-con-secreto-aleatorio-de-64-caracteres
CSRF_SECRET=reemplazar-con-otro-secreto-aleatorio-independiente
COOKIE_SECURE=true
SESSION_TTL=8h
TRUST_PROXY=false

SUPERUSER_EMAIL=admin@irtra.local
SUPERUSER_PASSWORD=cambiar-antes-del-primer-inicio

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_TIMEOUT_MS=90000

DATA_DIR=./data
DATABASE_URL=postgresql://irtra:irtra_local_change@127.0.0.1:5433/irtra_calidad
POSTGRES_PASSWORD=irtra_local_change
PGSSL=false
UPLOAD_DIR=./private_uploads
HTTPS_KEY_PATH=./certs/localhost-key.pem
HTTPS_CERT_PATH=./certs/localhost.pem

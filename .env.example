NODE_ENV=production
PORT=3443
BIND_HOST=127.0.0.1
APP_BASE_URL=https://localhost:3443
ALLOWED_ORIGINS=https://localhost:3443

# Genere valores aleatorios de al menos 64 caracteres. Nunca use estos ejemplos.
SESSION_SECRET=reemplazar-con-secreto-aleatorio-de-64-caracteres
CSRF_SECRET=reemplazar-con-otro-secreto-aleatorio-independiente
COOKIE_SECURE=true
SESSION_TTL=8h
TRUST_PROXY=false

SUPERUSER_EMAIL=admin@irtra.local
SUPERUSER_PASSWORD=Genere-Una-Clave-Unica-Larga-2026!

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_TIMEOUT_MS=90000

# Informes y alertas para personal interno. Nunca configure teléfonos de huéspedes.
REPORT_SCHEDULER_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
REPORT_FROM_EMAIL=
TEAMS_WEBHOOK_URL=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
INTERNAL_WHATSAPP_RECIPIENTS=
INTERNAL_ALERT_EMAILS=
INTERNAL_ALERT_CHANNELS=email

DATA_DIR=./data
DATABASE_URL=postgresql://irtra:CAMBIAR_CLAVE@127.0.0.1:5433/irtra_calidad
POSTGRES_PASSWORD=CAMBIAR_CLAVE
PGSSL=false
UPLOAD_DIR=./private_uploads
HTTPS_KEY_PATH=./certs/localhost-key.pem
HTTPS_CERT_PATH=./certs/localhost.pem

{
  "name": "irtra-calidad-ia",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/install-python-deps.mjs && next build",
    "postbuild": "node scripts/clean-build-cache.mjs",
    "start": "node --env-file-if-exists=.env.local server.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "retention": "node --env-file-if-exists=.env.local scripts/retention.mjs",
    "reprocess": "node --env-file-if-exists=.env.local scripts/reprocess.mjs",
    "sla:monitor": "node --env-file-if-exists=.env.local scripts/sla-monitor.mjs",
    "scanner": "node --env-file-if-exists=.env.local scripts/scanner.mjs",
    "scanner:remote": "node --env-file-if-exists=.env.scanner.local scripts/scanner-upload.mjs",
    "certs": "node scripts/generate-certs.mjs",
    "test": "node --env-file-if-exists=.env.local --test tests/*.test.mjs",
    "test:e2e": "node --env-file-if-exists=.env.local node_modules/@playwright/test/cli.js test",
    "qa:setup": "node scripts/qa.mjs setup",
    "qa:serve": "node scripts/qa.mjs serve",
    "qa:test": "node scripts/qa.mjs test",
    "qa:cypress": "node scripts/qa.mjs cypress",
    "qa:build": "node scripts/qa.mjs build",
    "qa:readiness": "node scripts/qa.mjs readiness",
    "qa:queue": "node scripts/qa.mjs queue",
    "qa:load": "node scripts/qa.mjs load",
    "qa:playwright": "node scripts/qa.mjs playwright",
    "qa:demo": "node scripts/qa.mjs demo",
    "docs:informe": "node scripts/render-informe.mjs",
    "cache:benchmark": "node --env-file-if-exists=.env.local scripts/cache-benchmark.mjs",
    "test:load": "node scripts/load-test.mjs",
    "test:queue": "node --env-file-if-exists=.env.local scripts/simulate-survey-queue.mjs --count=100 --concurrency=8",
    "security:readiness": "node --env-file-if-exists=.env.local scripts/production-readiness.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "jose": "^6.1.0",
    "next": "^16.4.3",
    "node-forge": "^1.4.2",
    "nodemailer": "^10.3.1",
    "openai": "^5.12.2",
    "pg": "^8.16.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.54.2",
    "cypress": "^16.2.1"
  },
  "optionalDependencies": {
    "ioredis": "^5.4.1"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.23"
    }
  },
  "engines": {
    "node": ">=22.5"
  }
}

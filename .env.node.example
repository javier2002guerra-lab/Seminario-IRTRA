NODE_ENV=development
APP_NAME=IRTRA Calidad IA
APP_BASE_URL=https://localhost:3443
PORT=3443

DATABASE_URL=postgres://postgres:postgres@localhost:5432/irtra_calidad_ia
PGSSLMODE=disable

JWT_SECRET=generar_con_node_crypto_randomBytes_64_base64url
COOKIE_SECRET=generar_otro_valor_distinto_con_node_crypto_randomBytes_64_base64url
SESSION_COOKIE_NAME=irtra_access
JWT_EXPIRES_IN=8h

OPENAI_API_KEY=tu_token_openai
OPENAI_MODEL=gpt-4.1
OPENAI_TIMEOUT_MS=90000
OPENAI_RATE_LIMIT_RETRIES=5
OPENAI_RATE_LIMIT_BASE_DELAY_MS=2500

SUPERUSER_USERNAME=Irtra
SUPERUSER_EMAIL=irtra@irtra.local
SUPERUSER_PASSWORD=cambia_esta_clave_por_una_muy_larga_con_numero_y_simbolo
SUPERUSER_NAME=Irtra

HTTPS_KEY_PATH=certs/localhost-key.pem
HTTPS_CERT_PATH=certs/localhost-cert.pem
UPLOAD_DIR=uploads
SCAN_WATCH_ENABLED=true
SCAN_WATCH_DIR=scanner_inbox
SCAN_ARCHIVE_DIR=scanner_inbox/procesados
SCAN_FAILED_DIR=scanner_inbox/fallidos
SCAN_SETTLE_MS=2500
SCAN_POLL_MS=5000
EXCEL_TEMPLATE_DIR=data/excel_templates
MAX_FILE_SIZE_MB=20
